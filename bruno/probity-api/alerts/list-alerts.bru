meta {
  name: List Alerts
  type: http
  seq: 1
}

get {
  url: {{probity_base_url}}/alerts?limit={{probity_limit}}
  body: none
  auth: bearer
}

params:query {
  limit: {{probity_limit}}
  ~status: active
  ~severity: high
  ~rule_code: DUPLICATE_DISBURSEMENT
  ~classification: fraud_risk
  ~category: relationship
  ~vendor_id: 
  ~from: 2024-01-01
  ~to: 2024-12-31
  ~cursor: 
}

auth:bearer {
  token: {{probity_api_key}}
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: false
  timeout: 0
}

docs {
  List alerts for the key's company, newest first. Requires `alerts:read`.

  Filters (all optional; toggle the ~disabled ones on to use):
  - status: active | open | investigating | confirmed | not_fraud | reviewed
    | closed | self_healed | superseded (or omit for the default queue)
  - severity: critical | high | medium | low
  - rule_code: e.g. DUPLICATE_DISBURSEMENT
  - vendor_id
  - from / to: YYYY-MM-DD, inclusive, anchored to the company timezone
  - cursor: pass the response's next_cursor for the next page

  Response: { data: Alert[], next_cursor, has_more }

  Each alert carries Probity's labels: `classification`
  (fraud_risk | hygiene | exploratory) and `category` (behavioral |
  relationship | financial | compliance | other), plus
  `transaction_risk_score` (0.0–1.0, NOT a probability of fraud; null when
  unscored).

  Timestamps: `event_date` (when the event occurred) vs `detected_at`
  (when Probity detected it — the alert fire time).

  Note: no amount and no title/description on the wire — v1 exposes
  structural fields only (severity, rule_code/rule_name, status, dates).

  Requires `alerts:read`; 403 without it.
}
